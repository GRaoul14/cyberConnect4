<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600" prefWidth="800" spacing="25" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">

<padding>
    <Insets bottom="40" left="40" right="40" top="40" />
</padding>

<Label styleClass="title-label" text="CHOOSE GAME MODE" />

<Button onAction="#startPlayerVsPlayer" prefHeight="60" prefWidth="300" styleClass="menu-button" text="PLAYER VS PLAYER" />

<Button onAction="#startPlayerVsAI" prefHeight="60" prefWidth="300" styleClass="menu-button" text="PLAYER VS AI" />

<Button onAction="#backToMenu" prefHeight="50" prefWidth="300" styleClass="menu-button" text="BACK TO MENU" />

</VBox>
