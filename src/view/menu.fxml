<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MenuController"
      alignment="CENTER"
      spacing="25"
      styleClass="menu-root">

    <padding>
        <Insets top="40" right="30" bottom="40" left="30"/>
    </padding>

    <Label text="CYBER"
           styleClass="menu-title"/>

    <Label text="CONNECT 4"
           styleClass="menu-subtitle"/>

    <Label text="CONNECT • COMPETE • CONQUER"
           styleClass="menu-tagline"/>

    <VBox alignment="CENTER"
          spacing="15"
          maxWidth="300">

        <Button text="JOUER"
                onAction="#startGame"
                styleClass="menu-button"
                maxWidth="Infinity"/>

        <Button text="COMMENT JOUER"
                onAction="#showRules"
                styleClass="menu-button"
                maxWidth="Infinity"/>

        <Button text="QUITTER"
                onAction="#quitGame"
                styleClass="menu-button"
                maxWidth="Infinity"/>

    </VBox>

    <Label text="SYSTEM READY // PLAYER 1 VS PLAYER 2"
           styleClass="menu-footer"/>

</VBox>