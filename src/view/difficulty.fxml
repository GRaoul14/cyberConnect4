<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="25" styleClass="menu-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">

    <padding>
        <Insets bottom="40" left="30" right="30" top="40" />
    </padding>

    <Label styleClass="menu-title" text="CYBER" />

    <Label styleClass="menu-subtitle" text="CONNECT 4" />

    <Label styleClass="menu-tagline" text="CHOOSE YOUR DIFFICULTY" />

    <VBox alignment="CENTER" maxWidth="300" spacing="15">

        <Button maxWidth="Infinity" onAction="#startEasy" styleClass="menu-button" text="EASY" />

        <Button maxWidth="Infinity" onAction="#startMedium" styleClass="menu-button" text="MEDIUM" />

        <Button maxWidth="Infinity" onAction="#startHard" styleClass="menu-button" text="HARD" />

        <Button maxWidth="Infinity" onAction="#back" styleClass="menu-button" text="BACK" />

    </VBox>

    <Label styleClass="menu-footer" text="SELECT YOUR LEVEL // PLAYER 1 VS AI" />

</VBox>
