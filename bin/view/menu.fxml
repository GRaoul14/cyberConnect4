<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="25" styleClass="menu-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">

    <padding>
        <Insets bottom="40" left="30" right="30" top="40" />
    </padding>

    <Label styleClass="menu-title" text="CYBER" />

    <Label styleClass="menu-subtitle" text="CONNECT 4" />

    <Label styleClass="menu-tagline" text="CONNECT • COMPETE • CONQUER" />

    <VBox alignment="CENTER" maxWidth="300" spacing="15">

        <Button maxWidth="Infinity" onAction="#startGame" styleClass="menu-button" text="PLAY" />

        <Button maxWidth="Infinity" onAction="#showRules" styleClass="menu-button" text="HOW TO PLAY" />

        <Button maxWidth="Infinity" onAction="#quitGame" styleClass="menu-button" text="EXIT" />

    </VBox>

</VBox>
